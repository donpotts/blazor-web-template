@page "/services"

<PageTitle>Services — @SiteConfig.SiteName</PageTitle>

<div class="bg-gray-100">
    <div class="max-w-5xl mx-auto px-6 py-14 text-center">
        <h1 class="text-2xl sm:text-3xl font-bold mb-8">@SiteConfig.ServicesSection.Heading</h1>
        <div class="flex flex-wrap justify-center gap-4">
            @foreach (var item in SiteConfig.ServicesSection.Items)
            {
                <div class="w-full sm:w-[45%] lg:w-60 bg-white rounded-lg shadow-sm p-4 text-left">
                    <h2 class="font-bold text-lg mb-1">@item.Title</h2>
                    <p class="text-gray-600 text-sm">@item.Description</p>
                </div>
            }
        </div>
    </div>
</div>
