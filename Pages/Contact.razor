@page "/contact"
@using System.Text.Json
@inject IJSRuntime JS

<PageTitle>Contact — @SiteConfig.SiteName</PageTitle>

<div class="bg-gray-100">
    <div class="max-w-lg mx-auto px-6 py-14">
        <h1 class="text-2xl sm:text-3xl font-bold mb-6 text-center">@SiteConfig.Contact.Heading</h1>
        <p class="text-center text-gray-700 mb-1">Phone: @SiteConfig.Contact.Phone</p>
        <p class="text-center text-gray-700 mb-8">Email: @SiteConfig.Contact.Email</p>

        <EditForm Model="_model" OnValidSubmit="HandleSend" class="space-y-4">
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Name</label>
                <InputText @bind-Value="_model.Name" placeholder="Your name"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-accent" />
            </div>
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Email</label>
                <InputText @bind-Value="_model.Email" placeholder="you@example.com"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-accent" />
            </div>
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Message</label>
                <InputTextArea @bind-Value="_model.Message" placeholder="How can we help?" rows="5"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-accent" />
            </div>
            <button type="submit" disabled="@(!CanSend)"
                    class="@(CanSend ? "w-full bg-accent text-white font-bold py-3 rounded-lg hover:opacity-90 transition-opacity" : "w-full bg-accent text-white font-bold py-3 rounded-lg opacity-50")">
                Send Message
            </button>
            @if (_sent)
            {
                <p class="text-center text-sm text-gray-500">Message saved locally in your browser (no backend — see README).</p>
            }
        </EditForm>

        <div class="mt-10">
            <h2 class="text-lg font-bold mb-3">Past submissions (this browser only)</h2>
            <div class="space-y-3">
                @if (_submissions.Count == 0)
                {
                    <p class="text-gray-500 text-sm text-center">No messages yet.</p>
                }
                else
                {
                    @foreach (var item in _submissions.AsEnumerable().Reverse())
                    {
                        <div class="border border-gray-200 rounded-lg p-4 bg-white">
                            <div class="flex justify-between items-baseline">
                                <span class="font-semibold text-gray-900">@item.Name</span>
                                <span class="text-xs text-gray-400">@item.Date.ToLocalTime().ToString("g")</span>
                            </div>
                            <div class="text-sm text-gray-500">@item.Email</div>
                            <p class="mt-2 text-gray-700">@item.Message</p>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    private const string StorageKey = "contact_submissions";
    private readonly ContactModel _model = new();
    private List<Submission> _submissions = new();
    private bool _sent;

    private bool CanSend =>
        !string.IsNullOrWhiteSpace(_model.Name) &&
        !string.IsNullOrWhiteSpace(_model.Email) &&
        !string.IsNullOrWhiteSpace(_model.Message);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _submissions = await LoadSubmissionsAsync();
            StateHasChanged();
        }
    }

    private async Task<List<Submission>> LoadSubmissionsAsync()
    {
        var json = await JS.InvokeAsync<string?>("localStorageInterop.getItem", StorageKey);
        if (string.IsNullOrEmpty(json)) return new List<Submission>();
        try
        {
            return JsonSerializer.Deserialize<List<Submission>>(json) ?? new List<Submission>();
        }
        catch
        {
            return new List<Submission>();
        }
    }

    private async Task HandleSend()
    {
        if (!CanSend) return;

        _submissions.Add(new Submission(_model.Name, _model.Email, _model.Message, DateTime.UtcNow));
        var json = JsonSerializer.Serialize(_submissions);
        await JS.InvokeVoidAsync("localStorageInterop.setItem", StorageKey, json);

        _model.Name = string.Empty;
        _model.Email = string.Empty;
        _model.Message = string.Empty;
        _sent = true;
    }

    private class ContactModel
    {
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
    }

    private record Submission(string Name, string Email, string Message, DateTime Date);
}
